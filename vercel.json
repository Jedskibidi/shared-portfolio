{
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/email\\.php",
      "dest": "/api/email.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}